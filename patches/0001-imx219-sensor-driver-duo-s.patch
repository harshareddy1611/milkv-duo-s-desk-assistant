+
+	CMOS_CHECK_POINTER(pstRxInitAttr);
+
+	if (pstRxInitAttr->stMclkAttr.bMclkEn)
+		pstRxAttr->mclk.cam = pstRxInitAttr->stMclkAttr.u8Mclk;
